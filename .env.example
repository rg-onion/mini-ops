# --- Required ---
# Secret token for Dashboard access (generate with: openssl rand -hex 32)
# Standalone local mode can generate this when empty. Managed systemd mode
# requires a preconfigured strong token and fails fast when it is empty.
AUTH_TOKEN=

# --- Optional (Notifications) ---
# Both values must be non-blank; otherwise Telegram delivery is disabled.
# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=
# Your Telegram Chat ID from @userinfobot
TELEGRAM_CHAT_ID=

# --- Advanced ---
# Optional database override. When unset, standalone mode uses
# sqlite:mini-ops.db and managed systemd mode uses
# sqlite:///var/lib/mini-ops/mini-ops.db.
# DATABASE_URL=sqlite:mini-ops.db
# Display name for this server in the dashboard (defaults to hostname)
SERVER_NAME=
# Language for alerts and logging (en|ru)
AGENT_LANG=en
# Logging level (debug|info|warn|error)
RUST_LOG=info
# Optional absolute path for the PAM SSH-alert internal token.
# Managed systemd default: /run/mini-ops/internal.token
# MINI_OPS_INTERNAL_TOKEN_FILE=/run/mini-ops/internal.token
# Disabled by default: enables `/api/ssh/setup-alerts` to edit PAM/system files.
MINI_OPS_ALLOW_SYSTEM_SETUP=false
# Disabled by default: enables the experimental source-build endpoint.
# A successful build does not install the artifact or restart the service.
MINI_OPS_ALLOW_WEB_UPDATE=false
# Maximum runtime for web-triggered updates in seconds (default: 1800).
MINI_OPS_WEB_UPDATE_TIMEOUT_SECS=1800
# Disabled by default: enables experimental cleanup for target, node_modules,
# and journald. Docker cleanup remains unavailable even when this is true.
MINI_OPS_ALLOW_DISK_CLEANUP=false
# Keep local metrics history for this many hours (default: 168).
METRICS_RETENTION_HOURS=168
# Keep SSH login history for this many days (default: 90).
SSH_LOGINS_RETENTION_DAYS=90
# Keep resolved security events for this many hours (default: 168).
SECURITY_EVENTS_RETENTION_HOURS=168
# Background security monitor interval in seconds (default: 300, min: 60).
SECURITY_AUDIT_INTERVAL_SECS=300
# Cache `/api/security/audit` responses for this many seconds (default: 30; set 0 to disable).
SECURITY_AUDIT_CACHE_TTL_SECS=30
# Timeout for Docker container inspection during security audit (default: 10).
SECURITY_AUDIT_DOCKER_TIMEOUT_SECS=10
# Additional public/wildcard listening ports expected by security audit.
# Defaults already include 22, 80, 443, and DEPLOY_NGINX_PORT.
SECURITY_ALLOWED_PUBLIC_PORTS=
# Additional loopback-only listening ports expected by security audit.
# Defaults already include APP_PORT.
SECURITY_ALLOWED_LOOPBACK_PORTS=

# --- Cloud Push (optional — remove or set false to disable) ---
# See docs/CLOUD_PUSH.md for a full explanation of what is sent and why.
CLOUD_PUSH_ENABLED=false
CLOUD_HUB_URL=https://your-hub.example.com
CLOUD_AGENT_ID=ag_your_agent_id_here
CLOUD_AGENT_TOKEN=your_agent_token_here
# Unset defaults to 60; an explicit value must be between 60 and 86400 seconds.
CLOUD_PUSH_INTERVAL=60
# Allow plain HTTP for local testing ONLY. Never set true in production.
# CLOUD_PUSH_ALLOW_HTTP=false

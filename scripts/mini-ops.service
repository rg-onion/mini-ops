[Unit]
Description=Mini-Ops Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=miniops
Group=miniops
WorkingDirectory=/var/lib/mini-ops
ExecStart=/opt/mini-ops/mini-ops
EnvironmentFile=/opt/mini-ops/.env
StateDirectory=mini-ops
StateDirectoryMode=0700
RuntimeDirectory=mini-ops
RuntimeDirectoryMode=0700
UMask=0077
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mini-ops /run/mini-ops

[Install]
WantedBy=multi-user.target
